#!/usr/bin/env python3
"""Git provenance Checks. One executable, one subcommand per registered id."""

from checks.gitcheck import run_git_author, run_git_fresh
from checks.toolmain import main


def handle(repo, check, args):
    if check == "git_fresh":
        return run_git_fresh(repo, args)
    if check == "git_author":
        return run_git_author(repo, args)
    return {"status": "fail", "detail": f"check {check!r} is not implemented"}


if __name__ == "__main__":
    raise SystemExit(main(handle))
