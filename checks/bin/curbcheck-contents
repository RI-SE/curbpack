#!/usr/bin/env python3
"""The contents Check."""

from checks.filecheck import run_contents
from checks.toolmain import main


def handle(repo, check, args):
    if check != "contents":
        return {"status": "fail", "detail": f"check {check!r} is not a subcommand of curbcheck-contents"}
    return run_contents(repo, args)


if __name__ == "__main__":
    raise SystemExit(main(handle))
