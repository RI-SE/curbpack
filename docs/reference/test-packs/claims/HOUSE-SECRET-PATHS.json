{
  "id": "HOUSE-SECRET-PATHS",
  "requirement_id": "HOUSE-SECRET-PATHS",
  "source": "documents",
  "args": {
    "paths": [
      "README.md",
      "SECURITY.md",
      ".well-known/security.txt",
      ".env",
      ".env.local",
      "credentials.json",
      "service-account.json",
      "id_rsa"
    ]
  },
  "description": "No secret-like patterns in house policy document paths or common agent secret files.",
  "severity": "critical",
  "checks": [
    {
      "check": "contents",
      "args": {
        "paths": [
          "README.md",
          "SECURITY.md",
          ".well-known/security.txt",
          ".env",
          ".env.local",
          "credentials.json",
          "service-account.json",
          "id_rsa"
        ],
        "probes": [
          {
            "kind": "pattern",
            "pattern": "(?i)(AKIA[0-9A-Z]{16}|-----BEGIN (RSA |OPENSSH )?PRIVATE KEY-----|api[_-]?key\\s*[:=]\\s*['\\\"]?[a-zA-Z0-9]{20,})"
          }
        ]
      }
    }
  ]
}
