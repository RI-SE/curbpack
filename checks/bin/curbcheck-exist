#!/usr/bin/env python3
"""The exist Check."""

from checks.filecheck import run_exist
from checks.toolmain import main


def handle(repo, check, args):
    if check != "exist":
        return {"status": "fail", "detail": f"check {check!r} is not a subcommand of curbcheck-exist"}
    return run_exist(repo, args)


if __name__ == "__main__":
    raise SystemExit(main(handle))
