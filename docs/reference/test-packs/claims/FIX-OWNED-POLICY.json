{
  "id": "FIX-OWNED-POLICY",
  "requirement_id": "FIX-OWNED-POLICY",
  "namespace": "RISE/Fresh and owned check fixture (test only)",
  "pack_id": "fresh-owned-test",
  "requirement_digest": "3258a1c3d4629d968c2768ee47a405602a365dbba0ffd688bb0592e727f40ddd",
  "source": "documents",
  "args": {
    "path": "docs/owned-policy.md"
  },
  "description": "Repo-bound draft with expected git author on last commit.",
  "severity": "high",
  "checks": [
    {
      "check": "contents",
      "args": {
        "path": "docs/owned-policy.md",
        "probes": [
          {
            "kind": "size",
            "bytes": 30,
            "op": ">="
          },
          {
            "kind": "token"
          }
        ]
      }
    },
    {
      "check": "git_author",
      "args": {
        "path": "docs/owned-policy.md",
        "email": "owner@example.com"
      }
    }
  ]
}
